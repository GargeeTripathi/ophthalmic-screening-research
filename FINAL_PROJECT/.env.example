# Copy to .env and point this at the folder that holds the ODIR-5K training JPEGs
# (0_left.jpg, 0_right.jpg, ...). The images are not redistributed with this project.
# A real environment variable of the same name wins over this file.
ODIR_IMAGES=path/to/ODIR-5K/Training Images

# Optional: where the local app listens (scripts/serve.py)
# HOST=127.0.0.1
# PORT=8000
